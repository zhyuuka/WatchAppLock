<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.watchapplock"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="27"
        android:targetSdkVersion="27" />

    <!-- ===== 锁核心：使用情况访问 ===== -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- ===== 前台 Service / 保活 ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- ===== 查询已安装应用包名（API 30+ 限制，targetSdk 27 不强制但声明无害） ===== -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- ===== 锁屏覆盖 ===== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ===== 手表形态声明 ===== -->
    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <permission
        android:name="com.watchapplock.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.watchapplock.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.watchapplock.App"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchAppLock" >

        <!-- ============ 主入口：设置界面 ============ -->
        <activity
            android:name="com.watchapplock.SettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WatchAppLock" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============ 锁屏 Activity（瞬时） ============ -->
        <activity
            android:name="com.watchapplock.LockScreenActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:lockTaskMode="if_whitelisted"
            android:noHistory="false"
            android:resizeableActivity="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.WatchAppLock.Lock" />

        <!-- ============ 常驻前台 Service ============ -->
        <service
            android:name="com.watchapplock.LockGuardService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- ============ 保活兜底任务（JobScheduler） ============ -->
        <service
            android:name="com.watchapplock.GuardJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- ============ 可选无障碍增强 ============ -->
        <service
            android:name="com.watchapplock.LockAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ============ 开机/解锁自启动 ============ -->
        <receiver
            android:name="com.watchapplock.BootReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter android:priority="1000" >
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ============ 设备管理员（防卸载，可选） ============ -->
        <receiver
            android:name="com.watchapplock.WalDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>